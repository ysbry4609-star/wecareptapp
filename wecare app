// ====== WhatsApp ======
function openWA(){
  if(!v('fn')){ toast('⚠️ أدخل اسم الحالة أولاً','#c0392b'); return; }
  document.getElementById('waT').textContent = build();
  document.getElementById('waOv').classList.add('open');
}
function closeWA(){ document.getElementById('waOv').classList.remove('open'); }
function copyWA(){
  const text = document.getElementById('waT').textContent;
  if(navigator.clipboard){
    navigator.clipboard.writeText(text).then(()=>{ toast('✅ تم النسخ — الصقه في الواتساب!'); closeWA(); });
  } else {
    const ta=document.createElement('textarea'); ta.value=text;
    document.body.appendChild(ta); ta.select(); document.execCommand('copy'); document.body.removeChild(ta);
    toast('✅ تم النسخ!'); closeWA();
  }
}

// ====== Excel Export ======
function exportExcel(){
  if(!v('fn')){ toast('⚠️ أدخل اسم الحالة أولاً','#c0392b'); return; }
  if(!v('fd')){ toast('⚠️ اختر التاريخ أولاً','#c0392b'); return; }
  
  const siteName = site==='taj' ? 'تاج' : 'سراي';
  const monthNames = ['يناير','فبراير','مارس','أبريل','مايو','يونيو','يوليو','أغسطس','سبتمبر','أكتوبر','نوفمبر','ديسمبر'];
  const dateVal = v('fd');
  const date = new Date(dateVal + 'T00:00:00');
  const monthNum = String(date.getMonth() + 1).padStart(2, '0');
  const year = date.getFullYear();
  const monthName = monthNames[date.getMonth()];
  
  const headers = getExcelHeaders();
  const row = getExcelRow();
  const storageKey = EXCEL_HISTORY_PREFIX + site + '_' + year + '_' + monthNum;
  let rows = [];
  try {
    rows = JSON.parse(localStorage.getItem(storageKey) || '[]');
  } catch (e) {
    console.warn('Could not read Excel history', e);
  }
  if(!rows.length){ rows.push(headers); }
  rows.push(row);
  localStorage.setItem(storageKey, JSON.stringify(rows));

  const wb = XLSX.utils.book_new();
  const ws = XLSX.utils.aoa_to_sheet(rows);
  ws['!cols'] = [{wch:16},{wch:12},{wch:12},{wch:16},{wch:20},{wch:8},{wch:8},{wch:16},{wch:20},{wch:20},{wch:20},{wch:35},{wch:25},{wch:12},{wch:10},{wch:10},{wch:10},{wch:10},{wch:10},{wch:24},{wch:24},{wch:24},{wch:24},{wch:20},{wch:20},{wch:20},{wch:95},{wch:12},{wch:18}];
  XLSX.utils.book_append_sheet(wb, ws, 'تقارير');
  const fname = `تقارير_${siteName}_${monthName}_${year}.xlsx`;
  XLSX.writeFile(wb, fname);
  toast(`✅ تم إنشاء: ${fname}\n📂 المجلد: Downloads`);
}

// ====== clear ======
function clearAll(){
  if(!confirm('مسح كل البيانات؟')) return;
  document.querySelectorAll('input,select,textarea').forEach(el=>{ if(el.type!=='date' && el.type!=='number') el.value=''; });
  document.getElementById('fd').value = new Date().toISOString().split('T')[0];
  document.getElementById('frt').value = new Date().toTimeString().slice(0,5);
  document.getElementById('vgc').value = '15/15';
  updateMonthYear();
  document.querySelectorAll('.pill').forEach(p=>{
    p.classList.remove('on');
    if(['ABCDE','IPSGs','ITLS'].includes(p.textContent)) p.classList.add('on');
  });
  saveDraft();
  toast('🗑️ تم مسح الفورم','#555');
}

