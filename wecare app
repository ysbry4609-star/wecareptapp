// ====== helpers ======
function tog(el){ el.classList.toggle('on'); saveDraft(); }
function v(id){ return (document.getElementById(id)||{}).value||''; }
function onPills(id){ return Array.from(document.querySelectorAll('#'+id+' .pill.on')).map(b=>b.textContent).join('، '); }
function getSymptomsText(){
  const excluded = new Set(['ABCDE','IPSGs','ITLS','BLS','ALS','Airway Mgmt','O2 Therapy','IV / Cannula','Nebulizer','Dressing','إحالة مستشفى','Psych Support',
    'الراحة التامة','شرب المياه الكافية','التغذية السليمة','تعويض السوائل / ORS','السلامة الغذائية','أطعمة خفيفة ومسلوقة','كمادات باردة','البعد عن الشمس','ممارسة الرياضة','النوم الكافي','متابعة internist','متابعة dentist','متابعة urologist','متابعة nephrologist','متابعة dermatologist','متابعة الطبيب والأدوية','طوارئ عند تدهور الحالة','قواعد السلامة أثناء العمل',
    'Paracetamol قرص','Ketolac قرص','Ketolac IM','Spasmodigestin قرص','Visceralgine IM','Dexamethasone IM','Primperan IM','Antinal','NS / سوائل وريدية','Glucose IM','Crosor نقط','Avil IM','Spasmofen IM','Hemolaclar مرهم','Move Massage','خافض حرارة أطفال']);
  return Array.from(document.querySelectorAll('.pill.on'))
    .filter(b=>!excluded.has(b.textContent))
    .map(b=>b.textContent)
    .join('، ');
}
function toast(msg,c='#1b6b3a'){
  const t=document.getElementById('tst');
  t.textContent=msg; t.style.background=c;
  t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),3000);
}
function collectDraft(){
  const draft = { site };
  document.querySelectorAll('input,select,textarea').forEach(el=>{ draft[el.id] = el.value; });
  document.querySelectorAll('.pill').forEach(p=>{ draft['pill:' + p.textContent.trim()] = p.classList.contains('on'); });
  return draft;
}
function saveDraft(){
  try {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(collectDraft()));
  } catch (e) {
    console.warn('Could not save draft', e);
  }
}
function restoreDraft(){
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if(!raw) return;
    const draft = JSON.parse(raw);
    if(draft.site) site = draft.site;
    document.querySelectorAll('input,select,textarea').forEach(el=>{ if(draft[el.id] !== undefined) el.value = draft[el.id]; });
    document.querySelectorAll('.pill').forEach(p=>{ const key='pill:' + p.textContent.trim(); p.classList.toggle('on', !!draft[key]); });
  } catch (e) {
    console.warn('Could not restore draft', e);
  }
}
function getExcelHeaders(){
  return ['التاريخ','ميعاد الإبلاغ','ميعاد الوصول','جهة الإبلاغ','اسم الحالة','العمر','الجنس','الوظيفة','مكان الحدث','الشكوى','التاريخ المرضي','الأعراض','تفاصيل إضافية','BP','SpO2','GCS','RBS','H.R','Temp','البروتوكولات','الأدوية','التعليمات','تفاصيل الإجراء','نتيجة التدخل','اسم المسعف','نوع الحدث','ملاحظات','نص التقرير','الموقع','وقت الحفظ'];
}
function getExcelRow(){
  return [
    v('fd'), v('frt'), v('fat'), v('fr'), v('fn'), v('fa'), v('fg'), v('fj'), v('fl'), v('fc'),
    v('fh'), getSymptomsText(), v('fcd'), v('vbp'), v('vsp'), v('vgc'), v('vrb'), v('vhr'), v('vtm'),
    onPills('proto-pills'), onPills('meds-pills'), onPills('edu-pills'), v('fpr'), v('foc'), v('fpa'), v('fet'), v('fno'), build(),
    site==='taj' ? 'تاج' : 'سراي', new Date().toLocaleString('ar-EG')
  ];
}

// ====== build report ======
function build(){
  const siteName = site==='taj' ? 'فريق إسعاف موقع تاج' : 'فريق إسعاف موقع سراي';
  const hist=v('fh')||'None', bp=v('vbp')||'/////', spo2=v('vsp')||'//',
        gcs=v('vgc')||'15/15', rbs=v('vrb')||'////', hr=v('vhr')||'///', temp=v('vtm')||'/////';

  const proto = onPills('proto-pills') || 'ABCDE, IPSGs, ITLS';
  const meds  = onPills('meds-pills');
  const edu   = onPills('edu-pills');
  const symp  = getSymptomsText();

  let cl = v('fc');
  if(v('fcd')) cl += ` (${v('fcd')})`;
  if(symp) cl += `، ${symp}`;

  let t = '';

  // ===== العنوان =====
  t += `⚕️ تقرير تدخل طبي`;
  if(v('fc')) t += ` — ${v('fc')}`;
  t += `\n\n`;

  // ===== بيانات الحالة =====
  t += `👤 بيانات الحالة:\n`;
  if(v('fr')) t += `* المبلغ: ${v('fr')}\n`;
  if(v('fl')) t += `* المكان: ${v('fl')}\n`;
  t += `* الاسم: ${v('fn')}\n`;
  if(v('fa')) t += `* السن: ${v('fa')} عاماً\n`;
  if(v('fj')) t += `* الوظيفة: ${v('fj')}\n`;
  if(cl) t += `* الشكوى والأعراض الحالية: ${cl}\n`;
  t += `* التاريخ المرضي: ${hist}\n`;
  t += `\n`;

  // ===== العلامات الحيوية =====
  t += `📊 أولاً: العلامات الحيوية (V/S) أثناء الفحص:\n`;
  t += `* درجة الوعي (GCS): ${gcs}\n`;
  t += `* ضغط الدم (BP): ${bp} mmHg\n`;
  t += `* نسبة الأكسجين (SpO2): ${spo2}%\n`;
  t += `* مستوى السكر العشوائي (RBS): ${rbs} mg/dL\n`;
  t += `* نبض القلب (H.R): ${hr} bpm\n`;
  t += `* درجة الحرارة (Temp): ${temp}°C\n`;
  t += `\n`;

  // ===== الإجراءات والتدخل الطبي =====
  t += `🛠️ ثانياً: الإجراءات والتدخل الطبي:\n`;
  t += `* البروتوكولات المُتبعة: ${proto}\n`;
  t += `* تم قياس العلامات الحيوية بدقة ومراقبتها\n`;
  if(meds) t += `* الأدوية والعلاج: ${meds}\n`;
  if(v('fpr')) t += `* ${v('fpr')}\n`;
  if(v('foc')) t += `* نتيجة التدخل: ${v('foc')}\n`;
  t += `\n`;

  // ===== التعليمات والنصائح الطبية =====
  t += `📢 ثالثاً: التعليمات والنصائح الطبية (Health Education):\n`;
  t += `* تم نصح المريض بـ: ${edu || 'الراحة وشرب المياه الكافية'}\n`;
  if(v('fee')) t += `* ${v('fee')}\n`;

  // ===== ملاحظات =====
  if(v('fno')) t += `\n📝 ملاحظات:\n${v('fno')}\n`;

  // ===== التذييل =====
  t += `\nEmergency and Critical Care Department, WeCare Company\n${siteName}`;
  if(v('fpa')) t += `\nاسم المسعف: ${v('fpa')}`;

  return t;
}

