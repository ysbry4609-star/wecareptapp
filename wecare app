const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxTHJowoY7X2LYhsbe52UppJu1k_AAvER3aW9Mt9GKSR2WZn6pXuilfPZBJWsdlvFvK/exec';

// ====== Save to Google Sheets ======
function saveToSheet(){
  if(!v('fn')){ toast('⚠️ أدخل اسم الحالة أولاً','#c0392b'); return; }
  const url = SCRIPT_URL;
  if(!url){ toast('⚠️ رابط Google Apps Script غير مُعد','#c0392b'); return; }

  const payload = {
    "الموقع": site === 'taj' ? 'تاج' : 'سراي',
    "التاريخ": v('fd'),
    "نوع الحدث": v('fet'),
    "تقرير عن الحدث": build(),
    "السن": v('fa'),
    "الوظيفه": v('fj'),
    "اسم الحاله": v('fn'),
    "ميعاد الابلاغ": v('frt'),
    "ميعاد الوصول": v('fat'),
    "مكان الحدث": v('fl')
  };

  const ov = document.createElement('div'); ov.className='ov open';
  ov.style.pointerEvents='none';
  document.body.appendChild(ov);

  fetch(url, { method: 'POST', mode: 'no-cors', body: JSON.stringify(payload) })
    .then(()=>{
      toast('✅ تم الحفظ في Google Sheets');
      document.body.removeChild(ov);
    }).catch(err=>{
      toast('⚠️ فشل الاتصال: ' + (err.message||''),'#c0392b');
      if(document.body.contains(ov)) document.body.removeChild(ov);
    });
}
